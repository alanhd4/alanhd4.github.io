
[
  {
    "label": "Start Website Server",
    "command": "browser-sync.cmd",
    "args": [
      "start",
      "--server",
      "--files",
      "*.html,*.css,*.js",
      "--port",
      "8000",
      "--no-open"
    ],
    "cwd": "$ZED_WORKTREE_ROOT",
    "use_new_terminal": true,
    "allow_concurrent_runs": false
  }
]
